{
  "name": "fitness-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --config server/wrangler.jsonc --local",
    "dev:web": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch:data": "node scripts/download-assets.mjs",
    "db:gen": "node scripts/generate-seed.mjs",
    "db:schema:local": "wrangler d1 execute fitness-db --config server/wrangler.jsonc --local --file=server/schema.sql",
    "db:schema:remote": "wrangler d1 execute fitness-db --config server/wrangler.jsonc --remote --file=server/schema.sql",
    "db:data:local": "wrangler d1 execute fitness-db --config server/wrangler.jsonc --local --file=server/seed.sql",
    "db:data:remote": "wrangler d1 execute fitness-db --config server/wrangler.jsonc --remote --file=server/seed.sql",
    "deploy": "npm run build && wrangler deploy --config server/wrangler.jsonc"
  },
  "dependencies": {
    "express": "^5.2.1",
    "i18next": "^26.4.4",
    "jose": "^6.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "pinyin-pro": "^3.29.5",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}