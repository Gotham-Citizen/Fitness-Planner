# Frontend build-time configuration (Vite exposes VITE_* vars to the client).
# Omit VITE_API_BASE for same-origin API calls (Cloudflare deploy + local dev proxy).

# Absolute URL of the deployed Worker API when the frontend is hosted elsewhere
# (e.g. GitHub Pages). Example: https://fitness-planner.<your-subdomain>.workers.dev
VITE_API_BASE=

# Base path the app is served from. Defaults to "/" (local dev, Cloudflare).
# For GitHub Pages project sites use /<repo-name>/ (set automatically by the
# deploy-pages workflow). Example: /Fitness-Planner/
VITE_BASE=

# Server-side CORS: which origin may call the API. "*" allows any origin.
# Only matters when the frontend is hosted on a different origin than the API.
CORS_ORIGIN=*

# Vite dev-server proxy target (vite.config.js, read via loadEnv).
# Set in .env to forward /api requests to your deployed Worker instead of the
# local wrangler dev server (npm run dev runs both together by default).
# Example: https://fitness-planner.<your-subdomain>.workers.dev
API_TARGET=